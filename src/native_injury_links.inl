struct InjuryCode {CodeLink government,rumor;};
static bool injury_guards_match(bool protection=true,bool herbal=true) {
    if(protection)for(const auto &l:injury_links)
        if(pointer(image,l.slot)!=image+l.original || memcmp(image+l.original,l.bytes,16))return false;
    return (!protection || (!memcmp(image+0x2ECE9,injury_rumor_call,9) &&
        !memcmp(image+0x29BF00,injury_assignment_clear_entry,16))) && (!herbal ||
        (!memcmp(image+0x53042,injury_government_call,5) &&
        !memcmp(image+0x2ED6B0,injury_policy_apply_entry,16) && !memcmp(image+0x22D2A0,injury_policy_capacity_entry,16) &&
        !memcmp(image+0x261B70,injury_policy_selection_entry,16)));
}
static bool prepare_injury(InjuryCode &code,Obj relay) {
    bool protection=true,herbal=true;
#ifdef SPLIT_BASE
    protection=mod_features.injury;herbal=mod_features.injury_herbal;
#endif
    if(!injury_guards_match(protection,herbal))return false;
    absolute_jump(relay+1600,reinterpret_cast<void *>(&injury_government_selection));
    // Replay MOV RCX,[RBP-60] before the replacement CALL. The original
    // CALL crosses a 16-byte boundary: atomically replace its MOV prefix and
    // skip the untouched two-byte tail with JMP +2 on return.
    memcpy(relay+1632,injury_rumor_call,4);
    absolute_jump(relay+1636,reinterpret_cast<void *>(&injury_rumor_actors));
    if((herbal && !prepare_link(code.government,0x53042,0xE8,relay+1600)) || (protection && !prepare_link(code.rumor,0x2ECE9,0xE8,relay+1632)))return false;
    if(protection) {code.rumor.modified[14]=0xEB;code.rumor.modified[15]=2;}
    return true;
}
// v12.8: protection = AI/actor nodes + rumor filter; herbal = government planning call.
static bool publish_injury(InjuryCode &code,bool protection,bool herbal) {
    if(protection) {
        for(const auto &l:injury_links)
            if(!patch_pointer(l.slot,l.original,reinterpret_cast<void *>(l.replacement)))return false;
        if(!publish_link(code.rumor))return false;
    }
    return !herbal || publish_link(code.government);
}
static void restore_injury(InjuryCode &code) {
    restore_link(code.rumor);restore_link(code.government);
    for(const auto &l:injury_links)restore_pointer(l.slot,l.original,reinterpret_cast<void *>(l.replacement));
}
